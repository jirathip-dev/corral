/target
*.ipa
*.dSYM.zip
fastlane/report.xml
fastlane/certs/
fastlane/README.md
build/

# Generated output is outside the anti-slop source scope. Keep both the
# project's generated iOS build tree and the vendored SwiftPM build products
# out of the worktree.
ios/build/
ios/tools/anti-slop-swift/.build/
ios/tools/anti-slop-swift/.swiftpm/

# Credential material — never tracked. The #36 leak was a tracked
# fastlane/.env whose own first line claimed it was gitignored; the CI
# secret scan (.github/workflows/secret-scan.yml) now enforces this against
# the git index rather than trusting these rules.
#
# `.env.*` covers .env.local / .env.production / .env.development, the
# common real-world names — the CI check matches the same set. The
# `.example` files are the documented contract (key names, empty values)
# and are the one exception, so they are re-included below.
.env
.env.*
*.env
!.env.example
!*.env.example
fastlane/.env
*.p8
*.p12
*.mobileprovision
*.cer

# TLS material a misplaced `tailscale cert` run would drop (see
# docs/OPERATIONS.md remote-access section: run it OUTSIDE the repo).
*.key
*.crt

# Private design-gate publication state; only the validated issue bundle is
# eligible for evidence review. Locks and sibling staging/rollback directories
# must never become tracked evidence or block a later safe recovery.
/docs/design/evidence/.design-gate.lock/
/docs/design/evidence/.design-gate.lock.recovery/
/docs/design/evidence/.design-gate.stage.*/
/docs/design/evidence/.design-gate.final.*/
/docs/design/evidence/.design-gate.backup.*/
