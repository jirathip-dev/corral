# fastlane/.env — App Store Connect API key credentials for TestFlight uploads.
# Copy this file to fastlane/.env and fill in the values. fastlane auto-loads
# it via fastlane/dotenv; it is gitignored so the real values never land in
# the repo. The key file (.p8) is also gitignored (see *.p8).
#
# Shared ASC API key with sendmeter (same team 9244PWFYD7).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
